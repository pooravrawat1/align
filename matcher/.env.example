# Copy to matcher/.env for npm run start:env. Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=15000
# fixture uses the reviewed hardcoded demo summaries and never calls Gemini.
# Change to live to try AI; the opt-in below then permits shared templates after a short wait.
MATCH_MODE=fixture
MATCH_LIVE_FALLBACK=false
MATCH_FALLBACK_TIMEOUT_MS=3000
MATCH_HOST=0.0.0.0
MATCH_PORT=4323

# Server only. Create a key with Text to Speech access; never put it in Unity or VITE_*.
ELEVENLABS_API_KEY=
# Sarah (female); replace with your preferred female voice ID if desired.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_TIMEOUT_MS=15000
